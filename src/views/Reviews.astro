---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ReviewForm from '../components/ReviewForm.astro';
import { url, type Lang } from '../i18n';
import { data, reviews } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = data(lang, 'site');
const p = data(lang, 'pages').reviews;
const list = await reviews();
---
<Base lang={lang} title={p.seo_title} description={p.seo_description}>
  <PageHero crumbs={[{ name: site.home, href: url(lang, '/') }, { name: p.kicker.replace('// ', '') }]} kicker={p.kicker} title={p.title} lead={p.lead} />

  {list.length > 0 && (
    <section class="sec" style="padding-top:3rem"><div class="wrap revs">
      {list.map((r, i) => <ReviewCard entry={r} lang={lang} delay={(i % 3) * 0.08} />)}
    </div></section>
  )}

  <section class="sec" style={list.length ? '' : 'padding-top:3rem'}><div class="wrap cgrid">
    <div>
      <ReviewForm lang={lang} />
    </div>
    <aside class="side-c">
      {list.length === 0 && <div class="chan hi"><span class="meta" style="color:var(--brass-hi)">{p.empty_title.toUpperCase()}</span><p style="color:var(--soft)">{p.empty_text}</p></div>}
      <div class="chan"><span class="meta">{p.side_title}</span><p style="color:var(--soft)">{p.side_text}</p></div>
    </aside>
  </div></section>
</Base>
