---
import Btn from './Btn.astro';
import { url, type Lang } from '../i18n';
import { data } from '../lib/data';
interface Props { lang: Lang; kicker?: string; title?: string; text?: string }
const site = data(Astro.props.lang, 'site');
const { lang, kicker = site.cta_block.kicker, title = site.cta_block.title, text = site.cta_block.text } = Astro.props;
---
<section class="sec"><div class="wrap">
  <div class="cta rv">
    <div style="display:flex;flex-direction:column;gap:1rem;position:relative;z-index:1"><p class="kicker">// {kicker}</p><h2>{title}</h2></div>
    <div class="side">
      <p style="color:var(--soft)">{text}</p>
      <div class="cta-row">
        <Btn href={url(lang, '/contact/')}>{site.cta_block.btn}</Btn>
        <Btn href={`https://t.me/${site.telegram}`} kind="g" external arrow={false}>Telegram @{site.telegram}</Btn>
      </div>
    </div>
  </div>
</div></section>
