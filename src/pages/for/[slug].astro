---
import View from '../../views/Niche.astro';
import { niches, slugOf } from '../../lib/data';
export async function getStaticPaths() {
  return (await niches('uk')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<View lang="uk" entry={entry} />
