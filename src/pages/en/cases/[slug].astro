---
import View from '../../../views/Case.astro';
import { cases, slugOf } from '../../../lib/data';
export async function getStaticPaths() {
  return (await cases('en')).filter((e) => e.data.has_page).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<View lang="en" entry={entry} />
