{
  // Cloudflare Workers: статичний сайт з dist/ + API для форми заявки
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "borovyk-automation.com", "custom_domain": true },
    { "pattern": "www.borovyk-automation.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
